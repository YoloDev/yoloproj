{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>YoloDev/renovate-config"],
  nix: {
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
  },
  enabledManagers: ["nix", "github-actions", "renovate-config-presets"],
  packageRules: [
    {
      matchManagers: ["github-actions"],
      pinDigests: true,
    },
  ],
}
